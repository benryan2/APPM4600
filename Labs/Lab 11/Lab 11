import numpy as np
import matplotlib.pyplot as plt

def composite_trap(a, b, f, N):
    h = (b-a)/(N-1)
    x = np.linspace(a, b, N)

    integral = f(x[0]) + f(x[-1])

    for i in range(1, N-1):
        integral += 2*f(x[i])

    return (h/2)*integral

def composite_simpson(a, b, f, N):

    h = (b-a)/(N-1)
    x = np.linspace(a, b, N)

    integral = f(x[0]) + f(x[-1])

    for i in range(1, N-1):
        if i % 2 == 1:
            integral += 4*f(x[i])
        else:
            integral += 2*f(x[i])

    return (h/3)*integral

